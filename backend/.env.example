DOAYA_DATABASE_URL=postgresql+psycopg://doaya:CHANGE_ME@localhost:5432/doaya
# PostgreSQL's bin folder, for the daily backup (empty: pg_dump from PATH).
# Windows: C:\Program Files\PostgreSQL\16\bin
DOAYA_PG_BIN_DIR=
# Where the token secret, backups and the log go.
DOAYA_DATA_DIR=data
# Optional: left out, the server generates one in data/jwt_secret.
# DOAYA_JWT_SECRET=
